# Server Configuration
PORT=5001
NODE_ENV=development

# Allowed Frontend Origins (pisahkan dengan koma jika ada lebih dari satu)
FRONTEND_URL=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Konfigurasi Rate Limiting TanggapAI
# Batas pesan chat per jendela 15 menit
CHAT_RATE_LIMIT_GUEST=20
CHAT_RATE_LIMIT_AUTH=100

# Konfigurasi Provider AI TanggapAI
# Pilihan provider yang didukung: groq (default), gemini, openai
AI_PROVIDER=groq

# Groq API Configuration (Provider Utama TanggapAI)
# Dapatkan API Key di: https://console.groq.com/
# Menggunakan base URL: https://api.groq.com/openai/v1 via OpenAI SDK compatibility client
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API (Provider Opsional / Alternatif)
# Dapatkan API Key di: https://aistudio.google.com/
# PENTING: Jangan commit API key sungguhan ke repository!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API (Provider Opsional / Alternatif)
# Dapatkan API Key di: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase Project Configuration (untuk verifikasi token peran pengguna)
SUPABASE_URL=https://gaxykcqqhsdigeviqosl.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
